    {
      "parameters": {
        "jsCode": "const text = $input.item.json.invoice_text;\n\nconst vendorMatch = text.match(/Invoice from (.*?),/);\nconst vendor = vendorMatch ? vendorMatch[1] : \"Not found\";\n\nconst amountMatch = text.match(/Amount:\\s*(\\d+)/);\nconst amount = amountMatch ? amountMatch[1] : \"Not found\";\n\nconst dateMatch = text.match(/Date:\\s*([\\d-]+)/);\nconst date = dateMatch ? dateMatch[1] : \"Not found\";\n\nconst dueDateMatch = text.match(/Due:\\s*([\\d-]+)/);\nconst dueDate = dueDateMatch ? dueDateMatch[1] : \"Not found\";\n\nreturn { vendor, amount, date, dueDate, status: \"Unpaid\" };"
      },
      "type": "n8n-nodes-base.code",
